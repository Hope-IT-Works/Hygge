# Copy this file to .env and adjust the values for your environment.
# See: https://raw.githubusercontent.com/TechnitiumSoftware/DnsServer/refs/heads/master/DockerEnvironmentVariables.md
#
# NOTE! Technitium only reads most of these environment variables when the DNS
# server starts for the very first time, i.e. when no config exists yet under
# ./volumes/technitium/config.
#
# Hygge's technitium-entrypoint.sh additionally reconciles DNS forwarder
# settings via the Technitium API on every container start so Unbound IP
# changes are picked up after restarts/recreates.
#
# Uncomment a variable here AND the matching line in docker-compose.yml's
# technitium service to actually apply it.

###############################################################################
# Active / commonly used
###############################################################################

# Fully qualified domain name Technitium uses to identify itself.
DNS_SERVER_DOMAIN=technitium

###############################################################################
# Admin account
###############################################################################

# Sets the initial admin password for the Technitium web console.
#DNS_SERVER_ADMIN_PASSWORD=

# Path to a file that contains a plain text password for the admin user
# (alternative to DNS_SERVER_ADMIN_PASSWORD).
#DNS_SERVER_ADMIN_PASSWORD_FILE=
#
# Used by Hygge's technitium-entrypoint.sh to authenticate against the API and
# update DNS forwarders on each start. If neither password variable is set
# after first boot, forwarder reconciliation is skipped with a warning.

###############################################################################
# Networking / IP protocol
###############################################################################

# DNS Server will use IPv6 for querying whenever possible.
#DNS_SERVER_PREFER_IPV6=false

###############################################################################
# Web console service
###############################################################################

# Host IP address that the web console port is bound to (docker-compose.yml
# "ports" mapping). Defaults to 0.0.0.0 (all interfaces) if unset. Set this
# to 127.0.0.1 if you run Technitium behind a reverse proxy on the same host
# and don't want the web console exposed on the network directly.
#WEB_SERVICE_HOST_BINDING=127.0.0.1

# Comma separated list of IP addresses for the DNS web console to listen on.
#DNS_SERVER_WEB_SERVICE_LOCAL_ADDRESSES=

# TCP port number for the DNS web console over HTTP protocol.
#DNS_SERVER_WEB_SERVICE_HTTP_PORT=5380

# TCP port number for the DNS web console over HTTPS protocol.
#DNS_SERVER_WEB_SERVICE_HTTPS_PORT=53443

# Enables HTTPS for the DNS web console.
#DNS_SERVER_WEB_SERVICE_ENABLE_HTTPS=false

# Enables self signed TLS certificate for the DNS web console.
#DNS_SERVER_WEB_SERVICE_USE_SELF_SIGNED_CERT=false

# File path to the TLS certificate for the DNS web console.
#DNS_SERVER_WEB_SERVICE_TLS_CERTIFICATE_PATH=

# Password for the TLS certificate for the DNS web console.
#DNS_SERVER_WEB_SERVICE_TLS_CERTIFICATE_PASSWORD=

# Enables HTTP to HTTPS redirection for the DNS web console.
#DNS_SERVER_WEB_SERVICE_HTTP_TO_TLS_REDIRECT=false

# Comma separated list of IP/network addresses allowed as reverse proxy.
# Prefix with ! to deny, e.g. !192.168.10.0/24.
#DNS_SERVER_WEB_SERVICE_REVERSE_PROXY_ADDRESSES=

###############################################################################
# DNS protocols
###############################################################################

# Enables DNS-over-HTTP on TCP port 80, for use behind a TLS terminating
# reverse proxy like nginx.
#DNS_SERVER_OPTIONAL_PROTOCOL_DNS_OVER_HTTP=false

###############################################################################
# Recursion
###############################################################################

# Recursion options: Allow, Deny, AllowOnlyForPrivateNetworks, UseSpecifiedNetworkACL.
#DNS_SERVER_RECURSION=AllowOnlyForPrivateNetworks

# Comma separated list of IP/network addresses to allow/deny recursion.
# Prefix with ! to deny. Valid only for UseSpecifiedNetworkACL.
#DNS_SERVER_RECURSION_NETWORK_ACL=

# Obsolete, use DNS_SERVER_RECURSION_NETWORK_ACL instead.
#DNS_SERVER_RECURSION_DENIED_NETWORKS=
#DNS_SERVER_RECURSION_ALLOWED_NETWORKS=

###############################################################################
# Blocking
###############################################################################

# Sets the DNS server to block domain names using Blocked Zone and Block List Zone.
DNS_SERVER_ENABLE_BLOCKING=true

# Respond with TXT records containing a blocked domain report for TXT requests.
#DNS_SERVER_ALLOW_TXT_BLOCKING_REPORT=false

# Comma separated list of block list URLs.
DNS_SERVER_BLOCK_LIST_URLS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts

###############################################################################
# Forwarders
###############################################################################

# Forwarder address is already configured directly in docker-compose.yml as
# DNS_SERVER_FORWARDERS=unbound:5335 (via Docker service discovery), so no
# entry is needed here.

# Forwarder protocol options: Udp, Tcp, Tls, Https, HttpsJson.
#DNS_SERVER_FORWARDER_PROTOCOL=Udp

###############################################################################
# Logging / stats
###############################################################################

# Use local time instead of UTC for logging.
#DNS_SERVER_LOG_USING_LOCAL_TIME=false

# Folder path where log files should be saved (relative to config folder allowed).
#DNS_SERVER_LOG_FOLDER_PATH=

# Max number of days to keep log files. 0 disables auto delete.
#DNS_SERVER_LOG_MAX_LOG_FILE_DAYS=0

# Enable in-memory stats; only Last Hour data available on Dashboard, nothing on disk.
#DNS_SERVER_STATS_ENABLE_IN_MEMORY_STATS=false

# Max number of days to keep dashboard stats. 0 disables auto delete.
#DNS_SERVER_STATS_MAX_STAT_FILE_DAYS=0

###############################################################################
# Single Sign-On (OpenID Connect)
###############################################################################

# Enable to allow Single Sign-On (SSO) with OpenID Connect (OIDC).
#DNS_SERVER_SSO_ENABLED=false

# The OpenID Connect (OIDC) Authority URL (Issuer).
#DNS_SERVER_SSO_AUTHORITY=

# The OpenID Connect (OIDC) Client ID.
#DNS_SERVER_SSO_CLIENT_ID=

# The OpenID Connect (OIDC) Client Secret.
#DNS_SERVER_SSO_CLIENT_SECRET=

# Path to a file with the OIDC Client Secret (alternative to the above).
#DNS_SERVER_SSO_CLIENT_SECRET_FILE=

# Custom OIDC metadata discovery URL (only if the provider uses a non-default one).
#DNS_SERVER_SSO_METADATA_ADDRESS=

# Comma separated list of OIDC scopes, e.g. openid,profile,email.
#DNS_SERVER_SSO_SCOPES=

# Allow automatic account provisioning for new SSO users.
#DNS_SERVER_SSO_ALLOW_SIGNUP=false

# Restrict SSO signup to users that are members of a mapped Remote Group.
#DNS_SERVER_SSO_ALLOW_SIGNUP_ONLY_FOR_MAPPED_USERS=false

# Comma separated list of "RemoteGroup:LocalGroup" pairs, e.g.
# Admins:Administrators,DNS Admins:DNS Administrators
#DNS_SERVER_SSO_GROUP_MAP=
